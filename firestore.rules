// firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /tasks/{taskId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /employees/{employeeId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /works/{workId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /movements/{movementId} {
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && resource.data.get('source', '') != 'payroll'
        && request.resource.data.get('source', '') != 'payroll';
      allow delete: if isOwner(resource.data.userId) && resource.data.get('source', '') != 'payroll';
      allow create: if isOwner(request.resource.data.userId);
    }

    match /payrolls/{payrollId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /budgets/{budgetId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /staff/{userId}/weeklyJournals/{journalId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && journalId == request.resource.data.weekStart + '_' + request.resource.data.employeeId;
    }

    match /staff/{userId}/weeklyClosures/{weekStart} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.weekStart == weekStart;
    }
  }
}
